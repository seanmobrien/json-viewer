{
  "compilerOptions": {
    "target": "ES5",
    "outDir": "./dist/out/",
    "rootDir": "./src/",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": false,
    "incremental": true,
    "declaration": true,
    "types": ["node", "react", "react-dom"],
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "composite": true
  },
  "include": ["./src"],
  "exclude": ["node_modules", "**/__tests__/**", "**/__mocks__/**", "**/tests/**"]
}
