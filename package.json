{
  "name": "@compliance-theater/json-viewer",
  "description": "Interactive Json Viewer, but not only a json viewer",
  "version": "4.0.2",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TexteaInc/json-viewer.git"
  },
  "author": "himself65 <himself65@outlook.com>",
  "bugs": "https://github.com/TexteaInc/json-viewer/issues",
  "homepage": "https://github.com/TexteaInc/json-viewer#readme",
  "keywords": [
    "react-18",
    "react",
    "react-json",
    "react-json-viewer",
    "array-viewer",
    "component",
    "interactive",
    "interactive-json",
    "json",
    "json-component",
    "json-display",
    "json-tree",
    "json-view",
    "json-viewer",
    "json-inspector",
    "json-tree",
    "tree",
    "tree-view",
    "treeview"
  ],
  "types": "dist/index.d.ts",
  "jsdelivr": "dist/browser.js",
  "unpkg": "dist/browser.js",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm --filter \"@compliance-theater/json-viewer-docs\" run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "postinstall": "husky install",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable",
    "lint": "npx eslint . --cache --fix",
    "lint:ci": "npx eslint . --cache --max-warnings 0",
    "build": "tsc && rollup -c rollup.config.ts --configPlugin swc3",
    "build:publish": "tsc && rollup -c rollup.config.ts --configPlugin swc3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^3.3.3",
    "zustand": "^4.5.5"
  },
  "lint-staged": {
    "!*.{ts,tsx,js,jsx}": "prettier --write --ignore-unknown",
    "*.{ts,tsx,js,jsx}": "npx eslint --cache --fix"
  },
  "peerDependencies": {
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@mui/material": "^6 || ^7 || ^8",
    "react": "^17 || ^18 || ^19",
    "react-dom": "^17 || ^18 || ^19"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.6.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.3.6",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^6.0.1",
    "@swc/core": "^1.13.5",
    "@testing-library/react": "^16.3.0",
    "@types/node": "25.2.3",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "expect-type": "^0.20.0",
    "husky": "9.1.7",
    "jsdom": "^26.1.0",
    "pinst": "^3.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rollup": "^4.28.1",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-swc3": "^0.12.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "browserslist": "4.23.3",
    "caniuse-lite": "1.0.30001660"
  }
}
